rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NYAYADRISHTI (न्यायदृष्टि) SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a Role-Based Access Control (RBAC) model combined with broad read access 
     * for authenticated judicial staff. It prioritizes "Authorization Independence" by ensuring 
     * documents contain necessary foreign keys (courtId, judgeId) to avoid expensive rule-based lookups.
     *
     * DATA STRUCTURE:
     * - Most entities (Courts, Judges, Cases, CaseTypes, Alerts) are stored in top-level collections 
     *   to facilitate flexible global querying and simplified security logic.
     * - Historical data (CourtMetricSnapshots) are nested under their respective Courts.
     * - Administrative status is determined by the existence of a document in the /roles_admin collection.
     *
     * KEY SECURITY DECISIONS:
     * - Public vs Private: All judicial data is restricted to authenticated users. No public access is allowed.
     * - Admin Dominance: Write operations (create, update, delete) across almost all collections are 
     *   restricted to users verified as Administrators.
     * - Relational Integrity: On creation, we ensure that document IDs provided in the path match 
     *   the internal 'id' field to maintain consistency.
     * - Prototyping Flexibility: Rules focus strictly on "Who" can access "What". The specific shape 
     *   and data types of content fields are not enforced here to allow for rapid UI/UX iteration.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the user is authenticated with any provider. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user has an entry in the admin roles collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** @description Verifies the document exists and the requester is an admin. Used for updates and deletes. */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    /** @description Validates that the data's ID matches the path's ID. */
    function matchesPathId(id) {
      return request.resource.data.id == id;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Access control for the administrative role registry.
     * @path /roles_admin/{userId}
     * @allow (get) If the user is an admin.
     * @deny (all) If the user is not a verified administrator.
     * @principle Database Access Control (DBAC) - The existence of the doc grants power.
     */
    match /roles_admin/{userId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && matchesPathId(userId);
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Information about judicial courts and tribunals.
     * @path /courts/{courtId}
     * @allow (read) Any signed-in user. (write) Verified admins only.
     * @deny (write) Any non-admin user.
     * @principle Role-based write access with authenticated read access.
     */
    match /courts/{courtId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && matchesPathId(courtId);
      allow update, delete: if isExistingAdmin();

      /**
       * @description Historical snapshots of court metrics.
       * @path /courts/{courtId}/metricSnapshots/{snapshotId}
       * @allow (read) Any signed-in user. (write) Admins or automated processes.
       * @deny (write) Standard authenticated users.
       * @principle Hierarchical data inheritance for snapshots.
       */
      match /metricSnapshots/{snapshotId} {
        allow get, list: if isSignedIn();
        allow create: if isAdmin() && matchesPathId(snapshotId);
        allow update, delete: if isExistingAdmin();
      }
    }

    /**
     * @description Profiles and performance metrics for judges.
     * @path /judges/{judgeId}
     * @allow (read) Any signed-in user. (write) Admins only.
     * @deny (create) If internal 'id' does not match the judgeId in path.
     * @principle Authorization Independence via denormalized courtId.
     */
    match /judges/{judgeId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && matchesPathId(judgeId);
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Legal case details and status tracking.
     * @path /cases/{caseId}
     * @allow (read) Any signed-in user. (write) Admins only.
     * @deny (update) If user is not an admin.
     * @principle Resource-specific role-based access.
     */
    match /cases/{caseId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && matchesPathId(caseId);
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Categories for legal cases (Lookup data).
     * @path /caseTypes/{caseTypeId}
     * @allow (read) Any signed-in user. (write) Admins only.
     * @deny (write) Attempts to modify core system categories by non-admins.
     * @principle Read-only lookup protection for general users.
     */
    match /caseTypes/{caseTypeId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && matchesPathId(caseTypeId);
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description System-generated notifications and alerts.
     * @path /alerts/{alertId}
     * @allow (read) Any signed-in user. (write) Admins only.
     * @deny (update) Any modification by non-admin staff.
     * @principle Flat structure for high-performance notification listing.
     */
    match /alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && matchesPathId(alertId);
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Global application and performance configuration.
     * @path /adminSettings/{settingId}
     * @allow (all) Verified administrators only.
     * @deny (read/write) Any non-admin user.
     * @principle Structural Segregation - Sensitive config isolated from standard users.
     */
    match /adminSettings/{settingId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && matchesPathId(settingId);
      allow update, delete: if isExistingAdmin();
    }

  }
}